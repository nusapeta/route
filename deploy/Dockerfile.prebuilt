# Runtime-only image: pakai bin/nusa-serve yang sudah dibangun di host.
# Berguna kalau registry lambat / tak mau tarik image golang (~800 MB).
#   cd deploy && NUSAPETA_ROUTE_DOCKERFILE=deploy/Dockerfile.prebuilt docker compose up -d --build
FROM alpine:3.22
RUN adduser -D -H -u 65532 nusapeta && apk add --no-cache ca-certificates
COPY bin/nusa-serve /usr/local/bin/nusa-serve
COPY bin/nusa-gateway /usr/local/bin/nusa-gateway
USER 65532:65532
EXPOSE 8080
ENV GOMEMLIMIT=768MiB
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1
ENTRYPOINT ["/usr/local/bin/nusa-serve"]
CMD ["-graph", "/data/indonesia.graph", "-addr", ":8080", "-conc", "1"]
