{
  "info": {
    "name": "routeid",
    "description": "Router OSM Indonesia. Semua URL absolut: http://127.0.0.1:8080 (jalankan bin/rid-server -graph data/java.graph -addr :8080). Import di Hoppscotch: Collections > Import > Postman; di Postman: File > Import. Tidak ada variabel, jadi langsung bisa di-enter.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. healthz (cek region)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://127.0.0.1:8080/healthz"
      }
    },
    {
      "name": "2. route GET polyline",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://127.0.0.1:8080/route?from=-6.2088,106.8456&to=-6.2297,106.8166&format=polyline"
      }
    },
    {
      "name": "3. route GET points (tanpa decode)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://127.0.0.1:8080/route?from=-6.2088,106.8456&to=-6.2297,106.8166&simplify=15"
      }
    },
    {
      "name": "4. route POST json",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://127.0.0.1:8080/route",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from\": { \"lat\": -6.2088, \"lng\": 106.8456 },\n  \"to\": { \"lat\": -6.2297, \"lng\": 106.8166 },\n  \"format\": \"polyline\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "5. route POST string coords",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://127.0.0.1:8080/route",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from\": \"-6.2088,106.8456\",\n  \"to\": \"-6.2297,106.8166\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "6. tanpa restriction (pembanding)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://127.0.0.1:8080/route?from=-6.2088,106.8456&to=-6.2297,106.8166&restrictions=0"
      }
    },
    {
      "name": "7. error 422 beda region (Jakarta -> Lampung)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://127.0.0.1:8080/route?from=-6.2088,106.8456&to=-5.4292,105.2611"
      }
