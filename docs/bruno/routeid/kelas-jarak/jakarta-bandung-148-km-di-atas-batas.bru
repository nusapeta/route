meta {
  name: Jakarta - Bandung 148 km (di atas batas)
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/route?from=-6.2088,106.8456&to=-6.9175,107.6191
  body: none
  auth: none
}

docs {
  Di atas batas 40 km: dengan konfigurasi compose jawabannya 422 dari pre-check
  garis lurus (116 km), dan itu yang diuji. Untuk uji kapasitas/tail, jalankan
  server dengan -max-route-km 0 atau 200 supaya 200 dan test memeriksa isinya.
  Jangan dipakai app.
}

tests {
  const code = res.getStatus();
  const j = res.getBody();
  test("422 dengan batas 40 km, atau 200 kalau batas dilonggarkan", function () {
    expect([200, 422]).to.include(code);
  });
  if (code === 422) {
    test("ditolak pre-check garis lurus", function () {
      expect(j.error).to.include("straight-line");
      expect(j.error).to.include("40 km");
    });
  } else {
    test("region + jarak + durasi", function () {
      expect(j.region).to.be.a("string");
      expect(j.distance_m).to.be.above(0);
      expect(j.duration_s).to.be.above(0);
    });
    test("points_n cocok dengan points", function () {
      expect(j.points).to.have.lengthOf(j.points_n);
    });
    test("snap terisi", function () {
      expect(j.snap_from_m).to.be.a("number");
      expect(j.snap_to_m).to.be.a("number");
    });
    console.log(j.region, j.distance_m + "m", j.duration_s + "s", j.points_n + " titik");
  }
}
